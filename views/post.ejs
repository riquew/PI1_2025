<%- include("header") -%>

<div class="container main">
    
    
    <div class="postCard">
        <div class="postImage">
            <img src="<%= conteudo.imagem %>">
        </div>
        <article>
            <h1><%= conteudo.nome %></h1>
            <p><%= conteudo.tipo %> 🐾</p>
            <p><%= conteudo.conteudo %></p>
            <p><%= conteudo.bairro %> <i class="fas fa-map-marker-alt"></i></p>
            <p><%= conteudo.telefone %>         <i class="fas fa-phone"></i></p>
            <div class="postCardLink">
                <a href="/">
                    <button class="btnReadMore">Voltar</button>
                </a>
            </div>
        </article>
    </div>
    
</div>
<%- include("footer") -%>